# =========================================
# application-secrets.properties.example — PLANTILLA
# Copia este fichero como config/application-secrets.properties
# y rellena los valores reales.
#
# En el VPS (servidor directo) puedes establecer estas variables:
#   a) Como variables de entorno del sistema:
#        export MONGODB_URI="mongodb+srv://user:pass@host/db"
#   b) En el fichero de servicio systemd:
#        [Service]
#        EnvironmentFile=/etc/tfg-hospital/secrets.env
# =========================================

# MongoDB Atlas o instancia propia
MONGODB_URI=mongodb+srv://<usuario>:<contrasena>@<cluster>.mongodb.net/?appName=<nombre>
MONGODB_DATABASE=hospital

# Puerto del servidor (opcional, por defecto 8080)
SERVER_PORT=8080

# URL base del frontend (para CORS y links en emails)
FRONTEND_BASE_URL=http://localhost:3000

# Remitente de emails
MAIL_FROM=Trassierra <support@tudominio.com>

# Clave API de Resend (si se usa el servicio de email)
RESEND_API_KEY=re_xxxxxxxxxxxx
